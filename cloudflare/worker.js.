export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const origin = request.headers.get("Origin") || "";

    const cors = {
      "Access-Control-Allow-Origin": SITE_ORIGIN,
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
      "Vary": "Origin"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: cors });
    }

    if (url.pathname === "/api/links" && request.method === "GET") {
      const saved = await env.LINKS.get("links", "json");
      return Response.json(saved || DEFAULT_LINKS, {
        headers: { ...cors, "Cache-Control": "no-store" }
      });
    }

    if (url.pathname === "/admin") {
      if (!(await verifyAccess(request, env))) {
        return new Response("Доступ запрещён. Войдите через Cloudflare Access.", {
          status: 403
        });
      }

      return new Response(ADMIN_HTML, {
        headers: { "Content-Type": "text/html; charset=utf-8" }
      });
    }

    if (url.pathname === "/api/admin/links" && request.method === "POST") {
      if (!(await verifyAccess(request, env))) {
        return Response.json({ error: "Доступ запрещён" }, {
          status: 403,
          headers: cors
        });
      }

      let links;
      try {
        links = await request.json();
      } catch {
        return Response.json({ error: "Некорректный JSON" }, {
          status: 400,
          headers: cors
        });
      }

      if (!Array.isArray(links) || links.length > 30) {
        return Response.json({ error: "Проверь список ссылок" }, {
          status: 400,
          headers: cors
        });
      }

      const cleanLinks = [];

      for (const item of links) {
        if (
          !item ||
          typeof item.name !== "string" ||
          typeof item.url !== "string" ||
          typeof item.icon !== "string"
        ) {
          return Response.json({ error: "Заполни название, ссылку и значок" }, {
            status: 400,
            headers: cors
          });
        }

        let parsed;
        try {
          parsed = new URL(item.url);
        } catch {
          return Response.json({ error: "Одна из ссылок указана неверно" }, {
            status: 400,
            headers: cors
          });
        }

        if (parsed.protocol !== "https:") {
          return Response.json({ error: "Разрешены только HTTPS-ссылки" }, {
            status: 400,
            headers: cors
          });
        }

        cleanLinks.push({
          name: item.name.trim().slice(0, 40),
          url: parsed.href,
          icon: item.icon.trim().slice(0, 8)
        });
      }

      await env.LINKS.put("links", JSON.stringify(cleanLinks));

      return Response.json({ success: true }, { headers: cors });
    }

    return new Response("Not found", { status: 404 });
  }
};

async function verifyAccess(request, env) {
  try {
    const token = request.headers.get("CF-Access-Jwt-Assertion");
    if (!token) return false;

    const parts = token.split(".");
    if (parts.length !== 3) return false;

    const decode = (value) => {
      const normalized = value.replace(/-/g, "+").replace(/_/g, "/");
      return JSON.parse(atob(normalized));
    };

    const header = decode(parts[0]);
    const claims = decode(parts[1]);

    if (header.alg !== "RS256" || !header.kid) return false;

    const issuer = `https://${env.ACCESS_TEAM_DOMAIN}`;
    if (claims.iss !== issuer) return false;
    if (claims.exp <= Math.floor(Date.now() / 1000)) return false;
    if (claims.nbf && claims.nbf > Math.floor(Date.now() / 1000)) return false;

    const audiences = Array.isArray(claims.aud) ? claims.aud : [claims.aud];
    if (!audiences.includes(env.ACCESS_AUD)) return false;
    if (claims.email?.toLowerCase() !== env.ADMIN_EMAIL.toLowerCase()) return false;

    const response = await fetch(`${issuer}/cdn-cgi/access/certs`);
    if (!response.ok) return false;

    const certs = await response.json();
    const jwk = certs.keys.find(key => key.kid === header.kid);
    if (!jwk) return false;

    const publicKey = await crypto.subtle.importKey(
      "jwk",
      jwk,
      { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" },
      false,
      ["verify"]
    );

    const encoder = new TextEncoder();
    const data = encoder.encode(`${parts[0]}.${parts[1]}`);
    const signatureString = parts[2].replace(/-/g, "+").replace(/_/g, "/");
    const signature = Uint8Array.from(
      atob(signatureString),
      character => character.charCodeAt(0)
    );

    return await crypto.subtle.verify(
      "RSASSA-PKCS1-v1_5",
      publicKey,
      signature,
      data
    );
  } catch {
    return false;
  }
}

const ADMIN_HTML = `<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
