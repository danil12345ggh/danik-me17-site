</style>
</head>
<body>
<main>
<h1>Danik — ссылки</h1>
<p>Добавляй, изменяй или удаляй ссылки. Изменения появятся на сайте после сохранения.</p>
<div id="list"></div>
<div class="actions">
<button id="add">＋ Добавить ссылку</button>
<button id="save">Сохранить изменения</button>
</div>
<div id="status"></div>
</main>
<script>
const list = document.getElementById("list");
const status = document.getElementById("status");

function addRow(item = {icon:"🔗",name:"",url:""}) {
  const row = document.createElement("div");
  row.className = "item";
  for (const [key, placeholder] of [
    ["icon","Значок"],["name","Название"],["url","https://..."]
  ]) {
    const input = document.createElement("input");
    input.value = item[key] || "";
    input.placeholder = placeholder;
    input.dataset.key = key;
    row.appendChild(input);
  }
  const remove = document.createElement("button");
  remove.className = "remove";
  remove.textContent = "×";
  remove.type = "button";
  remove.onclick = () => row.remove();
  row.appendChild(remove);
  list.appendChild(row);
}

async function load() {
  try {
    const response = await fetch("/api/links");
    if (!response.ok) throw new Error();
    const links = await response.json();
    links.forEach(addRow);
  } catch {
    status.textContent = "Не удалось загрузить ссылки.";
  }
}

document.getElementById("add").onclick = () => addRow();

document.getElementById("save").onclick = async () => {
  const links = [...list.querySelectorAll(".item")].map(row => {
    const item = {};
    row.querySelectorAll("input").forEach(input => {
      item[input.dataset.key] = input.value.trim();
    });
    return item;
  });

  if (links.some(item => !item.name || !item.url || !item.icon)) {
    status.textContent = "Заполни все поля или удали пустую строку.";
    return;
  }

  status.textContent = "Сохраняю...";
  try {
    const response = await fetch("/api/admin/links", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(links)
    });
    if (!response.ok) throw new Error();
    status.textContent = "Ссылки успешно сохранены!";
  } catch {
    status.textContent = "Не удалось сохранить. Проверь авторизацию и настройки.";
  }
};

load();
</script>
